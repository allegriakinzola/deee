# Copiez vers .env et renseignez les vraies valeurs (jamais Git).

# Neon — poolée (app) et directe (migrations)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"

# Compte opérateur (`npm run db:seed`)
GVB_ADMIN_EMAIL=
GVB_ADMIN_PASSWORD=

# Origine de l’app (sans slash final). Tous les liens absolus en dérivent.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# SMTP (invitations). Mot de passe d’application Gmail, jamais Git.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DEEE Kinshasa <vous@gmail.com>"
