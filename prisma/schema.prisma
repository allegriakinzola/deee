// Identité, accès, partenaires, shops, matériels, dépôts, ledger, réglages opérateur.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum IdentityType {
  EMAIL
  PHONE
}

enum UserRole {
  CITIZEN
  SHOP_STAFF
  PARTNER_ADMIN
  GVB_ADMIN
  GVB_COLLECTOR
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum PartnerKind {
  TELECOM
  BANK
  PRODUCTS
}

enum PartnerStatus {
  ACTIVE
  DISABLED
}

enum ShopStatus {
  ACTIVE
  DISABLED
}

enum CatalogStatus {
  ACTIVE
  DISABLED
}

enum DepositStatus {
  DRAFT
  SENT
  CONFIRMED
  REJECTED
}

enum LedgerKind {
  DEPOSIT_CREDIT
}

model User {
  id          String     @id @default(cuid())
  displayName String
  role        UserRole
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  identities Identity[]
  credential Credential?
  sessions   Session[]
  invitations Invitation[]
  sentInvitations Invitation[] @relation("InvitationSender")
  partnerMemberships PartnerMembership[]
  shopMembership     ShopMembership?
  citizenDeposits    Deposit[]      @relation("DepositCitizen")
  confirmedDeposits  Deposit[]      @relation("DepositConfirmer")
  ledgerEntries      LedgerEntry[]
}

/// Canal de connexion. Unique par (type, valeur normalisée).
/// Ajouter PHONE plus tard = une ligne, pas un nouveau modèle User.
model Identity {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       IdentityType
  value      String
  verifiedAt DateTime?
  createdAt  DateTime     @default(now())

  @@unique([type, value])
  @@index([userId])
}

/// Séparé de User : un compte invité peut exister avant d’avoir un mot de passe.
model Credential {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String
  updatedAt    DateTime @updatedAt
}

/// Le cookie ne contient que le jeton brut. Ici on stocke le hash.
model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Invitation à rejoindre la plateforme. Le jeton brut n’est jamais stocké.
/// Un compte User existe dès l’invitation ; le mot de passe arrive à l’acceptation.
model Invitation {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy   User      @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Entreprise partenaire (télécom, banque, produits). La GVB la crée.
model Partner {
  id        String        @id @default(cuid())
  name      String
  shortName String
  slug      String        @unique
  kind      PartnerKind
  logo      String?
  status    PartnerStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  memberships PartnerMembership[]
  shops       Shop[]

  @@index([kind])
  @@index([status])
}

/// Lien User ↔ Partner. Un PARTNER_ADMIN appartient à une entreprise.
model PartnerMembership {
  id        String   @id @default(cuid())
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([partnerId, userId])
  @@index([userId])
}

/// Point de dépôt. Appartient à un partenaire. Un seul compte (SHOP_STAFF).
model Shop {
  id        String     @id @default(cuid())
  partnerId String
  partner   Partner    @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  code      String     @unique
  area      String
  lat       Float
  lng       Float
  status    ShopStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  membership ShopMembership?
  deposits   Deposit[]

  @@unique([partnerId, slug])
  @@index([partnerId])
  @@index([status])
}

/// Un shop = un login. Le responsable ne gère pas d’autres comptes.
model ShopMembership {
  id        String   @id @default(cuid())
  shopId    String   @unique
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

/// Configuration opérateur GVB. Une seule ligne (id = "gvb").
/// La valeur d’un bon est globale : elle ne se règle pas par catalogue.
model OperatorSettings {
  id          String   @id
  bonUsdValue Decimal  @db.Decimal(10, 2)
  updatedAt   DateTime @updatedAt
}

/// Barème GVB. Les points d’un article se convertissent en USD, puis en bons
/// via OperatorSettings.bonUsdValue. Les citoyens échangeront des bons en shop.
model Catalog {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  usdPerPoint Decimal       @db.Decimal(10, 4)
  status      CatalogStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  items CatalogItem[]

  @@index([status])
}

/// Matériel accepté au dépôt. La catégorie est précodée ; le nom et les points
/// sont enregistrés en base.
model CatalogItem {
  id          String        @id @default(cuid())
  catalogId   String
  catalog     Catalog       @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  category    String
  name        String
  description String?
  unit        String        @default("Pièce")
  points      Int
  remarks     String?
  status      CatalogStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([catalogId, category, name])
  @@index([catalogId])
  @@index([category])
}

/// Matériel du barème, géré directement (sans catalogue).
model Material {
  id        String        @id @default(cuid())
  category  String
  name      String
  image     String
  unit      String        @default("Pièce")
  points    Int
  remarks   String?
  status    CatalogStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([category, name])
  @@index([category])
  @@index([status])

  depositLines DepositLine[]
}

/// Demande de dépôt. Les points ne sont crédités qu’à la confirmation shop.
model Deposit {
  id            String        @id @default(cuid())
  citizenId     String
  citizen       User          @relation("DepositCitizen", fields: [citizenId], references: [id], onDelete: Restrict)
  shopId        String?
  shop          Shop?         @relation(fields: [shopId], references: [id], onDelete: Restrict)
  status        DepositStatus @default(DRAFT)
  sentAt        DateTime?
  confirmedAt   DateTime?
  confirmedById String?
  confirmedBy   User?         @relation("DepositConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)
  rejectedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  lines         DepositLine[]
  ledgerEntries LedgerEntry[]

  @@index([citizenId, status])
  @@index([shopId, status])
}

model DepositLine {
  id         String   @id @default(cuid())
  depositId  String
  deposit    Deposit  @relation(fields: [depositId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)
  quantity   Int
  pointsEach Int
  name       String
  category   String
  image      String

  @@unique([depositId, materialId])
}

model LedgerEntry {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  depositId String?
  deposit   Deposit?   @relation(fields: [depositId], references: [id], onDelete: SetNull)
  kind      LedgerKind
  points    Int
  createdAt DateTime   @default(now())

  @@index([userId])
  @@unique([depositId, kind])
}
